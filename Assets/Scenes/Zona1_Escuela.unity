  textoInteraccion: {fileID: 1574423064}
  ventanaUI: {fileID: 538406065}
  gameManager: {fileID: 1358346452}
  tituloObjeto: Cubo de pintura con agua acumulada
  descripcionObjeto: "Un cubo viejo qued\xF3 afuera y acumul\xF3 agua de lluvia.
    \xBFQu\xE9 debes hacer?"
  opcion1: "Dejarlo ah\xED porque tiene poca agua."
  opcion2: Taparlo sin vaciar el agua.
  opcion3: Vaciarlo, limpiarlo y guardarlo boca abajo o bajo techo.
  opcionCorrecta: 2
  feedbackCorrecto: "\xA1Correcto! Mantener el cubo vac\xEDo y protegido evita que
    vuelva a acumular agua."
  feedbackIncorrecto: El cubo no debe quedarse con agua. Hay que vaciarlo y guardarlo
    correctamente.
  reduccionRiesgo: 40
  indiceZona: 1
