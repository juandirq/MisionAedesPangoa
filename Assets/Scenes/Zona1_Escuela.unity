  gameManager: {fileID: 1358346452}
  tituloObjeto: Tacho de basura con agua acumulada
  descripcionObjeto: "El tacho est\xE1 sucio y tiene agua de lluvia acumulada. \xBFQu\xE9
    debes hacer?"
  opcion1: Vaciar el agua, limpiar el tacho y mantenerlo tapado.
  opcion2: Dejarlo abierto para que el agua se evapore sola.
  opcion3: Moverlo de lugar sin vaciar el agua.
  opcionCorrecta: 0
  feedbackCorrecto: "\xA1Correcto! Vaciar y limpiar el tacho evita que el mosquito
    encuentre agua para reproducirse."
  feedbackIncorrecto: "Esa acci\xF3n no elimina el agua acumulada. Debes vaciar y
    limpiar el tacho."
  reduccionRiesgo: 30
  indiceZona: 1
