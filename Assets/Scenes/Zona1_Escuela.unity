  textoInteraccion: {fileID: 1436406326}
  ventanaUI: {fileID: 1137214053}
  gameManager: {fileID: 1358346452}
  tituloObjeto: Canaleta con hojas y agua acumulada
  descripcionObjeto: "La canaleta est\xE1 obstruida con hojas y agua estancada. \xBFQu\xE9
    acci\xF3n previene mejor que se formen criaderos?"
  opcion1: "Dejarla as\xED mientras el agua no rebalse."
  opcion2: Quitar las hojas y limpiar la canaleta para que el agua escurra.
  opcion3: Empujar un poco el agua, pero dejar la suciedad.
  opcionCorrecta: 1
  feedbackCorrecto: "\xA1Correcto! La canaleta debe quedar limpia y sin obstrucciones
    para que el agua no se estanque."
  feedbackIncorrecto: "Esa acci\xF3n no elimina el riesgo. La canaleta debe limpiarse
    para evitar acumulaci\xF3n de agua."
  reduccionRiesgo: 15
