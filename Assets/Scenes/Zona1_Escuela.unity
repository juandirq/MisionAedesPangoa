  textoInteraccion: {fileID: 1574423064}
  ventanaUI: {fileID: 538406065}
  gameManager: {fileID: 1358346452}
  tituloObjeto: Lavadero escolar con agua estancada
  descripcionObjeto: "El lavadero est\xE1 sucio y tiene agua acumulada desde hace
    varios d\xEDas. \xBFQu\xE9 acci\xF3n es la correcta?"
  opcion1: "Agregar m\xE1s agua para que se vea m\xE1s limpio."
  opcion2: Vaciar el agua, cepillar el lavadero y mantenerlo limpio.
  opcion3: Cubrirlo sin retirar el agua acumulada.
  opcionCorrecta: 1
  feedbackCorrecto: "\xA1Correcto! Vaciar y cepillar el lavadero elimina el agua
    estancada y reduce el riesgo de criaderos."
  feedbackIncorrecto: "Esa acci\xF3n no elimina el agua acumulada. El lavadero debe
    vaciarse y limpiarse correctamente."
  reduccionRiesgo: 30
  indiceZona: 1
