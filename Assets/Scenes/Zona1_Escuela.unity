  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoInteractuable
  textoInteraccion: {fileID: 1436406326}
  ventanaUI: {fileID: 1137214053}
  gameManager: {fileID: 1358346452}
  tituloObjeto: Llanta con agua acumulada
  descripcionObjeto: "Una llanta ha acumulado agua de lluvia. \xBFQu\xE9 acci\xF3n
    elimina mejor el riesgo de criadero?"
  opcion1: Vaciar el agua y dejar la llanta en el patio.
  opcion2: Vaciarla y guardarla bajo techo o retirarla.
  opcion3: Cubrirla sin retirar el agua acumulada.
  opcionCorrecta: 1
  feedbackCorrecto: "\xA1Correcto! Debe quedar sin agua y protegida de la lluvia
    o ser retirada."
  feedbackIncorrecto: "Esa acci\xF3n no elimina el riesgo. La llanta debe quedar
    sin agua y evitar que vuelva a llenarse."
  reduccionRiesgo: 15
