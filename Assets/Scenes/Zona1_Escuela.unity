  m_Script: {fileID: 11500000, guid: ef76521fcdda9ac48aba57f95d943d97, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoInteractuable
  textoInteraccion: {fileID: 1436406326}
  ventanaUI: {fileID: 1137214053}
  gameManager: {fileID: 1358346452}
  tituloObjeto: Balde con agua estancada
  descripcionObjeto: "El balde ha permanecido con agua durante varios d\xEDas. \xBFQu\xE9
    acci\xF3n reduce mejor el riesgo de que se convierta en un criadero?"
  opcion1: Taparlo y dejar el agua dentro.
  opcion2: Vaciarlo, limpiarlo y guardarlo boca abajo o bajo techo.
  opcion3: Vaciar solo parte del agua y dejarlo en el mismo lugar.
  opcionCorrecta: 1
  feedbackCorrecto: "\xA1Correcto! Vaciar, limpiar y guardar el balde de forma que
    no acumule agua evita que pueda convertirse en un criadero de Aedes aegypti."
  feedbackIncorrecto: "Esa acci\xF3n no elimina completamente el riesgo. El recipiente
    debe quedar sin agua acumulada y en una posici\xF3n que evite que vuelva a llenarse."
  reduccionRiesgo: 15
